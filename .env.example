# .env 로 복사해서 값을 채운다.
# .env 는 .gitignore 에 들어 있어 GitHub에 올라가지 않는다. 이 파일(.env.example)에는 실제 값을 넣지 않는다.

# Discord 서버 설정 → 연동(Integrations) → 웹후크 → 새 웹후크 → 채널 선택 → "웹후크 URL 복사"
# 이 주소만 있으면 누구나 그 채널에 글을 쓸 수 있으니 비밀번호처럼 다룬다.
DISCORD_WEBHOOK_URL=

# 선별·요약·검수 노드에서 사용 (https://platform.openai.com/api-keys)
OPENAI_API_KEY=
